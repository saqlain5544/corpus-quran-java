{{define "search.tmpl"}}{{template "layout" .}}{{end}}
{{define "content"}}
<div class="page-search">
  <header class="search-summary">
    <h1>{{if .Query}}Results for &ldquo;{{.Query}}&rdquo;{{else}}Search{{end}}</h1>
    {{if .Query}}
      <p class="search-meta">{{len .Results}} results in <span class="search-type">{{.Type}}</span></p>
    {{else}}
      <p class="search-meta">Use the box in the header to search by root, English gloss, or Arabic word.</p>
    {{end}}
  </header>

  {{if .Results}}
  <ol class="search-results">
    {{range .Results}}
      <li class="search-result" data-kind="{{.Kind}}">
        <a class="search-link" href="{{.Link}}">{{.Title}}</a>
        {{if .VerseText}}<p class="search-verse" lang="ar" dir="rtl">{{.VerseText}}</p>{{end}}
        {{if .Snippet}}<p class="search-snippet">{{.Snippet}}</p>{{end}}
        {{if .Root}}<small class="search-root">root: <a href="/root/detailed/{{.Root}}">{{.Root}}</a></small>{{end}}
      </li>
    {{end}}
  </ol>
  {{else if .Query}}
  <p class="search-empty">No matches.</p>
  {{end}}
</div>
{{end}}
