{{define "homepage.tmpl"}}{{template "layout" .}}{{end}}
{{define "content"}}
<div class="page-home">
  <header class="layout-header">
    <h1>Quran Reader</h1>
    <p class="layout-header-meta">Read, search, and explore the Quran with full morphology.</p>
  </header>
  <section class="surface surface--bare" aria-label="Surahs">
    <ol class="surah-grid">
      {{range $i, $s := .Surahs}}
        <li class="surah-card">
          <a class="surah-link" href="/surah/{{$s.Number}}">
            <span class="surah-number">{{$s.Number}}</span>
            <span class="surah-name">{{$s.Name}}</span>
            <span class="surah-count">{{index $.Meta.AyahCounts $i}} ayahs</span>
          </a>
        </li>
      {{end}}
    </ol>
  </section>
</div>
{{end}}
