// ── Quran Corpus — Single SQLite Database ──────────────────────
//
// Design:
//   • No data repetition — each fact stored once
//   • Proper foreign keys
//   • Unique constraints on natural keys
//   • Indexes on all foreign keys + search fields
//   • TEXT for Arabic Unicode (UTF-8)
//   • JSON for complex nested data

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Surah {
  id                   Int     @id
  name                 String
  englishName          String
  englishTranslation   String
  revelationType       String
  verseCount           Int

  verses     Verse[]
  words      Word[]
  rootRefs   RootReference[]

  @@map("surah")
}

model Verse {
  id       Int    @id @default(autoincrement())
  surahId  Int
  number   Int
  text     String

  surah Surah @relation(fields: [surahId], references: [id])
  words Word[]

  @@unique([surahId, number])
  @@index([surahId])
  @@map("verse")
}

model Word {
  id                Int    @id @default(autoincrement())
  surahId           Int
  verseId           Int
  number            Int
  token             String
  withoutDiacritics String
  translation       String?
  punctuationMark   String?

  surah    Surah     @relation(fields: [surahId], references: [id])
  verse    Verse     @relation(fields: [verseId], references: [id])
  segments Segment[]

  @@unique([verseId, number])
  @@index([surahId])
  @@index([verseId])
  @@map("word")
}

model Segment {
  id                   Int    @id @default(autoincrement())
  wordId               Int
  number               Int
  text                 String
  partOfSpeech         String
  morphType            String
  lemma                String?
  root                 String?
  gender               String?
  caseField            String? @map("case_field")
  syntacticRole        String?
  gloss                String?
  possessiveConstruct  String?
  caseMoodMarker       String?
  invariableDeclinable String?
  phrase               String?
  phrasalFunction      String?
  punctuationMark      String?

  word Word @relation(fields: [wordId], references: [id])

  @@unique([wordId, number])
  @@index([wordId])
  @@index([root])
  @@map("segment")
}

model RootReference {
  id          Int    @id @default(autoincrement())
  root        String
  surahId     Int
  verseNumber Int
  wordNumber  Int

  surah Surah @relation(fields: [surahId], references: [id])

  @@index([root])
  @@map("root_reference")
}

model RootMeaning {
  id                Int    @id
  root              String @unique
  rootArabic        String
  generalMeaning    String
  shadesOfMeaning   String
  hadithExamples    String
  classicalSources  String
  idiomsCustoms     String
  wordByWordShades  String
  pos               String?
  modelUsed         String?

  @@index([root])
  @@map("root_meaning")
}
