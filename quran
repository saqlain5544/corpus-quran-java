#!/usr/bin/env python3
"""quran — CLI for querying any Quran variant with morphology."""

import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))

import argparse
from jqurantree import (
    Quran, Morphology, Reader, TokenSearch,
    surah_name, verse_count, align, Align,
    diff_variants_lemmas, normalize_rasm,
)

def cmd_gloss(args):
    q = Quran(args.variant)
    glosses = q.gloss(args.sura, args.aya)
    for i, g in enumerate(glosses, 1):
        print(f"  {i}. {g}")

def cmd_roots(args):
    q = Quran(args.variant)
    roots = q.roots(args.sura, args.aya)
    for i, r in enumerate(roots, 1):
        print(f"  {i}. {r}")

def cmd_pos(args):
    q = Quran(args.variant)
    for i, p in enumerate(q.pos(args.sura, args.aya), 1):
        print(f"  {i}. {p}")

def cmd_word(args):
    q = Quran(args.variant)
    words = q.words(args.sura, args.aya)
    for w in words:
        print(f"  [{w.word_index}] {w.text}")
        print(f"       gloss: {w.gloss}")
        print(f"       POS:   {', '.join(w.pos_tags)}")
        if w.lemmas:
            print(f"       lemma: {', '.join(w.lemmas)}")
        if w.segments:
            for s in w.segments:
                print(f"       seg: {s.segmented_text:<6s} {s.pos:<20s} {s.gloss}")
        print()

def cmd_read(args):
    r = Reader(args.variant)
    for an in range(args.start, min(args.end or args.start, args.max or 9999) + 1):
        text = r.verse(args.sura, an)
        if text:
            print(f"{an}. {text}")

def cmd_search(args):
    from jqurantree import parse_xml, Document
    # Initialize Document if needed
    try:
        Document.get().get_token_count()
    except:
        xmlp = Path.home()/".cache"/"quran"/"quran-uthmani.xml"
        if not xmlp.exists():
            xmlp = Path(__file__).resolve().parent/"data"/"quran-text"/"quran-uthmani.xml"
        if xmlp.exists():
            Document.reset()
            parse_xml(xmlp)
    ts = TokenSearch()
    ts.find_substring(args.query, remove_diacritics=True)
    t = ts.get_results()
    print(f"{t.get_row_count()} results for '{args.query}':")
    for i in range(min(args.limit or 30, t.get_row_count())):
        print(f"  {t.get_integer(i,'Chapter')}:{t.get_integer(i,'Verse')}:{t.get_integer(i,'Token')}  {t.get_string(i,'Text')}")

def cmd_diff(args):
    d = diff_variants_lemmas(args.a, args.b)
    print(f"{args.a} ↔ {args.b}:")
    print(f"  Word-set similarity: {d['word_similarity_pct']}%")
    print(f"  Identical verses:   {d['same_words']}/{d['total_verses']}")
    if args.examples:
        for ex in d.get('examples', [])[:args.examples]:
            print(f"  {ex['chapter']}:{ex['verse']}")
            if 'only_in_a' in ex:
                print(f"    A-only: {ex['only_in_a'][:3]}")
            if 'only_in_b' in ex:
                print(f"    B-only: {ex['only_in_b'][:3]}")

def cmd_align(args):
    a = normalize_rasm(args.a)
    b = normalize_rasm(args.b)
    print(f"Normalized A: {a}")
    print(f"Normalized B: {b}")
    print(f"Match: {a == b}")

def cmd_info(args):
    m = Morphology()
    print(f"MASAQ: {m.segment_count():,} segments, {m.word_count():,} words")
    print(f"Roots:  {len(m.roots()):,}")
    print(f"Variants available:")
    from jqurantree.variants import VARIANTS
    for k, v in VARIANTS.items():
        print(f"  {k:<16s} {v.name}")

def cmd_surah(args):
    print(f"{'#':<4s} {'Surah':<25s} {'Verses':>6s}")
    print("-" * 38)
    for s in range(1, 115):
        print(f"{s:<4d} {surah_name(s):<25s} {verse_count(s):>6d}")

def main():
    p = argparse.ArgumentParser(description="Quran CLI — query any variant with morphology")
    sub = p.add_subparsers(dest="cmd")

    g = sub.add_parser("gloss", help="English gloss per word")
    g.add_argument("sura", type=int); g.add_argument("aya", type=int)
    g.add_argument("-v","--variant", default="uthmani")

    r = sub.add_parser("roots", help="Triliteral roots")
    r.add_argument("sura", type=int); r.add_argument("aya", type=int)
    r.add_argument("-v","--variant", default="uthmani")

    ps = sub.add_parser("pos", help="Part-of-speech tags")
    ps.add_argument("sura", type=int); ps.add_argument("aya", type=int)
    ps.add_argument("-v","--variant", default="uthmani")

    w = sub.add_parser("word", help="Full word analysis")
    w.add_argument("sura", type=int); w.add_argument("aya", type=int)
    w.add_argument("-v","--variant", default="uthmani")

    rd = sub.add_parser("read", help="Read verses")
    rd.add_argument("sura", type=int); rd.add_argument("start", type=int)
    rd.add_argument("-e","--end", type=int); rd.add_argument("-m","--max", type=int)
    rd.add_argument("-v","--variant", default="uthmani")

    sr = sub.add_parser("search", help="Search the Quran")
    sr.add_argument("query")
    sr.add_argument("-l","--limit", type=int)
    sr.add_argument("-v","--variant", default="uthmani")

    d = sub.add_parser("diff", help="Compare two variants")
    d.add_argument("a"); d.add_argument("b")
    d.add_argument("-x","--examples", type=int, default=0)

    al = sub.add_parser("align", help="Normalize and compare two words")
    al.add_argument("a"); al.add_argument("b")

    sub.add_parser("info", help="Show data stats")
    sub.add_parser("surahs", help="List all surahs")

    args = p.parse_args()
    if not args.cmd:
        p.print_help()
        return

    {"gloss":cmd_gloss,"roots":cmd_roots,"pos":cmd_pos,"word":cmd_word,
     "read":cmd_read,"search":cmd_search,"diff":cmd_diff,"align":cmd_align,
     "info":cmd_info,"surahs":cmd_surah}[args.cmd](args)

if __name__ == "__main__":
    main()
